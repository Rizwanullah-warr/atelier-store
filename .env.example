# Copy to .env.local and fill in the values.

# Neon Postgres connection string (Neon console -> Connect)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Better Auth
# Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Checkout. Leave both empty to keep checkout switched off.
# Secret key: Stripe Dashboard -> Developers -> API keys -> Secret key.
# Use the test-mode key (starts with sk_test_) until you are ready to take real payments.
STRIPE_SECRET_KEY=""
# Webhook signing secret (starts with whsec_).
# Local development: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# Production: Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
# Without it, orders are still confirmed when the customer returns from Stripe.
STRIPE_WEBHOOK_SECRET=""

# Email (password reset, email verification) through Resend. Leave empty to keep
# email switched off: the UI then says "email isn't set up" instead of sending.
# Create a key at resend.com -> API Keys. Until you verify a domain in Resend you
# can only send from onboarding@resend.dev and only to your own Resend account email.
RESEND_API_KEY=""
# Optional sender, e.g. "Atelier <hello@yourdomain.com>" (domain must be verified in Resend).
EMAIL_FROM=""
